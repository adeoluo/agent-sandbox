flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Agent([Agent tool call]):::edge
        CLI["CLI<br/>run, check, inspect"]:::edge
        Stdio["serve<br/>JSON Lines on stdio"]:::edge
        Lib["Sandbox API<br/>run, read, write"]:::core
        CLI ~~~ Stdio ~~~ Agent --> Lib
    end

    subgraph Decision["Decision layer"]
        direction TB
        Policy["Policy file<br/>TOML or JSON"]:::control
        Compile["Policy compiler<br/>validate, resolve"]:::control
        Engine{"Engine::decide<br/>ordered checks"}:::core
        Paths["Path resolver<br/>symlink-aware"]:::control
        Patterns["Glob matcher<br/>args and env"]:::control
        Policy --> Compile --> Engine
        Engine -.-> Paths ~~~ Patterns
    end

    subgraph Boundary["Process boundary"]
        direction TB
        Supervisor["Spawn, supervise<br/>own process group"]:::core
        Limits["rlimits, timeout<br/>output caps"]:::control
        OS["OS backend<br/>Seatbelt or Landlock"]:::control
        Child(["Command<br/>absolute binary"]):::edge
        Supervisor --> Limits --> OS --> Child
    end

    subgraph Audit["Audit and outputs"]
        direction TB
        Outcome["Outcome<br/>exit, signal, output"]:::obs
        Log[("Audit log<br/>SHA-256 chain")]:::data
        Verify["audit verify<br/>chain + head hash"]:::obs
        Outcome --> Log --> Verify
    end

    Interfaces -->|request| Decision
    Decision -->|allow| Boundary
    Decision -->|deny| Audit
    Boundary -->|outcome| Audit
